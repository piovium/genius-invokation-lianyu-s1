generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "client"
  runtime    = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum CompetitionStatus {
  NONE
  REGISTERED
  PLAYER
}

enum EventPhase {
  DECK_COLLECTION
  RUNNING
  FINISHED
}

enum MatchMode {
  UNRESTRICTED
  DUEL
  CONQUEST
}

enum ParticipantStatus {
  ACTIVE
  WITHDRAWN
}

enum GameStatus {
  PENDING
  FINISHED
}

enum GameEndReason {
  NORMAL
  ENGINE_ERROR
  SURRENDER
  ADMIN
}

enum MatchDeckDisableReason {
  DUEL_USED
  CONQUEST_WINNER_USED
  ADMIN
}

enum AuthChallengeKind {
  REGISTRATION
  AUTHENTICATION
}

model User {
  id                Int                @id @default(autoincrement())
  qq                String             @unique
  name              String
  chessboardColor   String?
  passwordHash      String?
  role              UserRole           @default(USER)
  competitionStatus CompetitionStatus  @default(NONE)
  appliedAt         DateTime?
  activeMatchId     Int?
  activeMatch       TournamentMatch?   @relation("ActiveMatch", fields: [activeMatchId], references: [id], onDelete: SetNull)
  passkeys          Passkey[]
  decks             Deck[]
  gamePlayers       GamePlayer[]
  matchParticipants MatchParticipant[]
  matchDecks        MatchDeck[]
  wonMatches        TournamentMatch[]  @relation("MatchWinner")
  auditLogs         AuditLog[]         @relation("AuditActor")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([competitionStatus, appliedAt])
  @@index([activeMatchId])
}

model Passkey {
  id         String    @id
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicKey  Bytes
  counter    BigInt
  transports String[]
  deviceType String?
  backedUp   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

model AuthChallenge {
  id        String            @id
  kind      AuthChallengeKind
  qq        String
  challenge String
  payload   Json?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([qq, kind, expiresAt])
}

model RegistrationSetting {
  id        Int       @id @default(1)
  opensAt   DateTime?
  cutoffAt  DateTime?
  limit     Int       @default(0)
  updatedAt DateTime  @updatedAt
}

model Deck {
  id              Int          @id @default(autoincrement())
  name            String
  code            String
  requiredVersion Int
  owner           User         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerUserId     Int
  clientImportKey String?
  matchDecks      MatchDeck[]
  gamePlayers     GamePlayer[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([ownerUserId, clientImportKey])
  @@index([ownerUserId, updatedAt])
}

model TournamentEvent {
  id        Int               @id @default(autoincrement())
  name      String
  phase     EventPhase        @default(DECK_COLLECTION)
  deckLimit Int               @default(0)
  matches   TournamentMatch[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([phase])
}

model TournamentMatch {
  id             Int                @id @default(autoincrement())
  eventId        Int
  event          TournamentEvent    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  mode           MatchMode          @default(UNRESTRICTED)
  roomConfig     Json
  maxGames       Int
  winsRequired   Int
  winnerUserId   Int?
  winner         User?              @relation("MatchWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)
  autoCreateGame Boolean            @default(false)
  participants   MatchParticipant[]
  matchDecks     MatchDeck[]
  games          Game[]
  activeUsers    User[]             @relation("ActiveMatch")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([eventId])
  @@index([winnerUserId])
}

model MatchParticipant {
  matchId   Int
  match     TournamentMatch   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    Int
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  who       Int
  status    ParticipantStatus @default(ACTIVE)
  createdAt DateTime          @default(now())

  @@id([matchId, userId])
  @@unique([matchId, who])
  @@index([userId])
}

model MatchDeck {
  id              Int                     @id @default(autoincrement())
  matchId         Int
  match           TournamentMatch         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId          Int
  user            User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceDeckId    Int?
  sourceDeck      Deck?                   @relation(fields: [sourceDeckId], references: [id], onDelete: SetNull)
  name            String
  deckJson        Json
  code            String
  requiredVersion Int
  characterKey    String
  usable          Boolean                 @default(true)
  disableReason   MatchDeckDisableReason?
  frozenAt        DateTime?
  gamePlayers     GamePlayer[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([matchId, userId, characterKey])
  @@unique([matchId, userId, sourceDeckId])
  @@index([matchId, userId, usable])
}

model Game {
  id              Int              @id @default(autoincrement())
  persistenceKey  String?          @unique
  matchId         Int?
  match           TournamentMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  status          GameStatus       @default(PENDING)
  coreVersion     String
  gameVersion     String
  stateLog        Json?
  winnerWho       Int?
  manualWinnerWho Int?
  endReason       GameEndReason?
  countForStats   Boolean          @default(true)
  roundCount      Int?
  players         GamePlayer[]
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([matchId, status])
  @@index([status, countForStats])
}

model GamePlayer {
  gameId       Int
  game         Game       @relation(fields: [gameId], references: [id], onDelete: Cascade)
  who          Int
  userId       Int?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  deckId       Int?
  deck         Deck?      @relation(fields: [deckId], references: [id], onDelete: SetNull)
  matchDeckId  Int?
  matchDeck    MatchDeck? @relation(fields: [matchDeckId], references: [id], onDelete: SetNull)
  deckName     String?
  deckJson     Json?
  characterKey String?

  @@id([gameId, who])
  @@index([userId])
  @@index([deckId])
  @@index([matchDeckId])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId Int
  actor       User     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  action      String
  targetType  String
  targetId    String
  reason      String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
}
